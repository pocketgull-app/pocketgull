FROM gemma2:2b

# Runtime Parameters
PARAMETER temperature 0.1
PARAMETER top_p 0.9
PARAMETER stop "<end_of_turn>"
PARAMETER stop "<eos>"

# Clinical System Instruction
SYSTEM """You are PocketGull Tern, an ultra-low latency on-device clinical triage assistant. Provide sub-45ms telegraphic clinical triage, vital sign risk tiering, and concise stepped-care guidance."""

# Clinical Prompt Template
TEMPLATE """<start_of_turn>user
{{ .Prompt }}<end_of_turn>
<start_of_turn>model
{{ .Response }}<end_of_turn>"""
