<div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-6">
  <div class="border-b border-slate-800 pb-4">
    <h2 class="text-xl font-bold text-white">EHR SMART-on-FHIR Session Launch</h2>
    <p class="text-sm text-slate-400 mt-1">Initiating OAuth2 authorization code grant flow with hospital EHR endpoint.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="bg-slate-950 p-4 rounded-xl border border-slate-800/80">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Target ISS Server</div>
      <div class="text-sm font-mono text-cyan-400 mt-1 truncate"><%= @iss %></div>
    </div>
    <div class="bg-slate-950 p-4 rounded-xl border border-slate-800/80">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">SMART Launch Context</div>
      <div class="text-sm font-mono text-emerald-400 mt-1 truncate"><%= @launch_id || "Standalone Launch" %></div>
    </div>
  </div>

  <div class="bg-slate-950/60 p-4 rounded-xl border border-slate-800">
    <h3 class="text-sm font-medium text-slate-300 mb-2">Authorized OAuth Scopes</h3>
    <div class="flex flex-wrap gap-2">
      <span class="px-2.5 py-1 bg-slate-800 text-slate-300 rounded-md text-xs font-mono">launch</span>
      <span class="px-2.5 py-1 bg-slate-800 text-slate-300 rounded-md text-xs font-mono">patient/*.read</span>
      <span class="px-2.5 py-1 bg-slate-800 text-slate-300 rounded-md text-xs font-mono">openid</span>
      <span class="px-2.5 py-1 bg-slate-800 text-slate-300 rounded-md text-xs font-mono">fhirUser</span>
    </div>
  </div>

  <div class="pt-2 flex justify-end">
    <a href="<%= @authorize_url %>" class="px-6 py-3 bg-gradient-to-r from-cyan-500 to-emerald-500 hover:from-cyan-400 hover:to-emerald-400 text-slate-950 font-semibold rounded-xl shadow-lg shadow-cyan-500/25 transition-all flex items-center gap-2">
      <span>Connect EHR Sandbox</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
    </a>
  </div>
</div>
