{
  "$schema": "vscode://schemas/color-theme",
  "name": "PocketGull Risograph Studio",
  "type": "light",
  "colors": {
    "activityBar.activeBorder": "#ec4899",
    "activityBar.background": "#efe8d8",
    "activityBar.foreground": "#ec4899",
    "activityBar.inactiveForeground": "#78716c",
    "activityBarBadge.background": "#ec4899",
    "activityBarBadge.foreground": "#ffffff",
    "badge.background": "#ec4899",
    "badge.foreground": "#ffffff",
    "button.background": "#ec4899",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#db2777",
    "diffEditor.insertedTextBackground": "#05966922",
    "diffEditor.removedTextBackground": "#e11d4822",
    "dropdown.background": "#ffffff",
    "dropdown.border": "#e5dec9",
    "dropdown.foreground": "#1e3a8a",
    "editor.background": "#fdfbf7",
    "editor.findMatchBackground": "#fef08a88",
    "editor.findMatchHighlightBackground": "#fef08a44",
    "editor.foreground": "#1e3a8a",
    "editor.lineHighlightBackground": "#f7f2e7",
    "editor.selectionBackground": "#fef08a66",
    "editor.selectionHighlightBackground": "#ec48991f",
    "editorBracketMatch.background": "#ec489922",
    "editorBracketMatch.border": "#ec489988",
    "editorCursor.foreground": "#ec4899",
    "editorGroup.border": "#e5dec9",
    "editorGroupHeader.tabsBackground": "#f2ebd9",
    "editorGutter.addedBackground": "#059669",
    "editorGutter.deletedBackground": "#e11d48",
    "editorGutter.modifiedBackground": "#d97706",
    "editorIndentGuide.activeBackground1": "#d5cca9",
    "editorIndentGuide.background1": "#e8e1cf",
    "editorLineNumber.activeForeground": "#ec4899",
    "editorLineNumber.foreground": "#a8a29e",
    "editorWidget.background": "#fdfbf7",
    "editorWidget.border": "#e5dec9",
    "focusBorder": "#ec4899",
    "input.background": "#ffffff",
    "input.border": "#e5dec9",
    "input.foreground": "#1e3a8a",
    "input.placeholderForeground": "#78716c",
    "inputOption.activeBorder": "#ec4899",
    "list.activeSelectionBackground": "#f5eedc",
    "list.activeSelectionForeground": "#1e3a8a",
    "list.hoverBackground": "#f7f2e7",
    "list.inactiveSelectionBackground": "#efe8d8",
    "panel.background": "#fdfbf7",
    "panel.border": "#e5dec9",
    "panelTitle.activeBorder": "#ec4899",
    "panelTitle.activeForeground": "#ec4899",
    "panelTitle.inactiveForeground": "#78716c",
    "peekView.border": "#ec4899",
    "peekViewEditor.background": "#faf6ed",
    "peekViewResult.background": "#f2ebd9",
    "scrollbarSlider.activeBackground": "#78716c66",
    "scrollbarSlider.background": "#78716c33",
    "scrollbarSlider.hoverBackground": "#78716c4d",
    "sideBar.background": "#f7f2e7",
    "sideBar.border": "#e5dec9",
    "sideBar.foreground": "#1e3a8a",
    "sideBarSectionHeader.background": "#f2ebd9",
    "sideBarSectionHeader.foreground": "#ec4899",
    "sideBarTitle.foreground": "#ec4899",
    "statusBar.background": "#1e3a8a",
    "statusBar.debuggingBackground": "#d97706",
    "statusBar.foreground": "#ffffff",
    "statusBar.noFolderBackground": "#1e3a8a",
    "statusBarItem.hoverBackground": "#172554",
    "statusBarItem.remoteBackground": "#ec4899",
    "statusBarItem.remoteForeground": "#ffffff",
    "tab.activeBackground": "#fdfbf7",
    "tab.activeBorderTop": "#ec4899",
    "tab.activeForeground": "#1e3a8a",
    "tab.border": "#e5dec9",
    "tab.inactiveBackground": "#f2ebd9",
    "tab.inactiveForeground": "#78716c",
    "terminal.ansiBlack": "#1e3a8a",
    "terminal.ansiBlue": "#2563eb",
    "terminal.ansiBrightBlack": "#64748b",
    "terminal.ansiBrightBlue": "#3b82f6",
    "terminal.ansiBrightCyan": "#06b6d4",
    "terminal.ansiBrightGreen": "#10b981",
    "terminal.ansiBrightMagenta": "#f472b6",
    "terminal.ansiBrightRed": "#f87171",
    "terminal.ansiBrightWhite": "#ffffff",
    "terminal.ansiBrightYellow": "#facc15",
    "terminal.ansiCyan": "#0891b2",
    "terminal.ansiGreen": "#059669",
    "terminal.ansiMagenta": "#ec4899",
    "terminal.ansiRed": "#e11d48",
    "terminal.ansiWhite": "#e5dec9",
    "terminal.ansiYellow": "#d97706",
    "terminal.background": "#fdfbf7",
    "terminal.foreground": "#1e3a8a",
    "titleBar.activeBackground": "#efe8d8",
    "titleBar.activeForeground": "#1e3a8a",
    "titleBar.border": "#e5dec9",
    "titleBar.inactiveBackground": "#f7f2e7",
    "titleBar.inactiveForeground": "#78716c"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#78716c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control",
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#ec4899",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": ["entity.name.function", "meta.function-call", "support.function"],
      "settings": {
        "foreground": "#7e22ce"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#047857"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": ["constant.numeric", "constant.language", "support.constant"],
      "settings": {
        "foreground": "#d97706"
      }
    },
    {
      "name": "Types & Classes",
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": {
        "foreground": "#1e3a8a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": ["variable", "variable.parameter", "variable.other"],
      "settings": {
        "foreground": "#1e3a8a"
      }
    },
    {
      "name": "Properties & Object Keys",
      "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name"],
      "settings": {
        "foreground": "#0284c7"
      }
    },
    {
      "name": "HTML & XML Tags",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#ec4899"
      }
    },
    {
      "name": "HTML & CSS Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#7e22ce"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": ["markup.heading", "punctuation.definition.heading"],
      "settings": {
        "foreground": "#ec4899",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#2563eb"
      }
    }
  ]
}
