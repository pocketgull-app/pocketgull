{
  "$schema": "vscode://schemas/color-theme",
  "name": "PocketGull Carrara Marble",
  "type": "light",
  "colors": {
    "activityBar.activeBorder": "#0ea5e9",
    "activityBar.background": "#edf0f4",
    "activityBar.foreground": "#0ea5e9",
    "activityBar.inactiveForeground": "#64748b",
    "activityBarBadge.background": "#0ea5e9",
    "activityBarBadge.foreground": "#ffffff",
    "badge.background": "#0ea5e9",
    "badge.foreground": "#ffffff",
    "button.background": "#0284c7",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#0ea5e9",
    "diffEditor.insertedTextBackground": "#10b98122",
    "diffEditor.removedTextBackground": "#ef444422",
    "dropdown.background": "#ffffff",
    "dropdown.border": "#e2e8f0",
    "dropdown.foreground": "#0f172a",
    "editor.background": "#faf9f6",
    "editor.findMatchBackground": "#0ea5e944",
    "editor.findMatchHighlightBackground": "#0ea5e922",
    "editor.foreground": "#0f172a",
    "editor.lineHighlightBackground": "#f1f3f7",
    "editor.selectionBackground": "#0ea5e928",
    "editor.selectionHighlightBackground": "#0ea5e916",
    "editorBracketMatch.background": "#0ea5e922",
    "editorBracketMatch.border": "#0ea5e988",
    "editorCursor.foreground": "#0ea5e9",
    "editorGroup.border": "#e2e8f0",
    "editorGroupHeader.tabsBackground": "#edf0f4",
    "editorGutter.addedBackground": "#10b981",
    "editorGutter.deletedBackground": "#ef4444",
    "editorGutter.modifiedBackground": "#f59e0b",
    "editorIndentGuide.activeBackground1": "#94a3b8",
    "editorIndentGuide.background1": "#e2e8f0",
    "editorLineNumber.activeForeground": "#0ea5e9",
    "editorLineNumber.foreground": "#94a3b8",
    "editorWidget.background": "#faf9f6",
    "editorWidget.border": "#e2e8f0",
    "focusBorder": "#0ea5e9",
    "input.background": "#ffffff",
    "input.border": "#e2e8f0",
    "input.foreground": "#0f172a",
    "input.placeholderForeground": "#64748b",
    "inputOption.activeBorder": "#0ea5e9",
    "list.activeSelectionBackground": "#e2e8f0",
    "list.activeSelectionForeground": "#0f172a",
    "list.hoverBackground": "#edf2f7",
    "list.inactiveSelectionBackground": "#e7ecf2",
    "panel.background": "#faf9f6",
    "panel.border": "#e2e8f0",
    "panelTitle.activeBorder": "#0ea5e9",
    "panelTitle.activeForeground": "#0ea5e9",
    "panelTitle.inactiveForeground": "#64748b",
    "peekView.border": "#0ea5e9",
    "peekViewEditor.background": "#f1f5f9",
    "peekViewResult.background": "#edf0f4",
    "scrollbarSlider.activeBackground": "#64748b66",
    "scrollbarSlider.background": "#64748b33",
    "scrollbarSlider.hoverBackground": "#64748b4d",
    "sideBar.background": "#f4f5f8",
    "sideBar.border": "#e2e8f0",
    "sideBar.foreground": "#0f172a",
    "sideBarSectionHeader.background": "#edf0f4",
    "sideBarSectionHeader.foreground": "#0ea5e9",
    "sideBarTitle.foreground": "#0ea5e9",
    "statusBar.background": "#0f172a",
    "statusBar.debuggingBackground": "#f59e0b",
    "statusBar.foreground": "#faf9f6",
    "statusBar.noFolderBackground": "#0f172a",
    "statusBarItem.hoverBackground": "#1e293b",
    "statusBarItem.remoteBackground": "#0284c7",
    "statusBarItem.remoteForeground": "#ffffff",
    "tab.activeBackground": "#faf9f6",
    "tab.activeBorderTop": "#0ea5e9",
    "tab.activeForeground": "#0f172a",
    "tab.border": "#e2e8f0",
    "tab.inactiveBackground": "#edf0f4",
    "tab.inactiveForeground": "#64748b",
    "terminal.ansiBlack": "#0f172a",
    "terminal.ansiBlue": "#0284c7",
    "terminal.ansiBrightBlack": "#64748b",
    "terminal.ansiBrightBlue": "#38bdf8",
    "terminal.ansiBrightCyan": "#06b6d4",
    "terminal.ansiBrightGreen": "#10b981",
    "terminal.ansiBrightMagenta": "#a855f7",
    "terminal.ansiBrightRed": "#ef4444",
    "terminal.ansiBrightWhite": "#ffffff",
    "terminal.ansiBrightYellow": "#f59e0b",
    "terminal.ansiCyan": "#0ea5e9",
    "terminal.ansiGreen": "#059669",
    "terminal.ansiMagenta": "#7c3aed",
    "terminal.ansiRed": "#dc2626",
    "terminal.ansiWhite": "#e2e8f0",
    "terminal.ansiYellow": "#d97706",
    "terminal.background": "#faf9f6",
    "terminal.foreground": "#0f172a",
    "titleBar.activeBackground": "#edf0f4",
    "titleBar.activeForeground": "#0f172a",
    "titleBar.border": "#e2e8f0",
    "titleBar.inactiveBackground": "#f4f5f8",
    "titleBar.inactiveForeground": "#64748b"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#64748b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control",
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#0284c7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": ["entity.name.function", "meta.function-call", "support.function"],
      "settings": {
        "foreground": "#0d9488"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#059669"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": ["constant.numeric", "constant.language", "support.constant"],
      "settings": {
        "foreground": "#d97706",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Types & Classes",
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": {
        "foreground": "#6366f1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": ["variable", "variable.parameter", "variable.other"],
      "settings": {
        "foreground": "#0f172a"
      }
    },
    {
      "name": "Properties & Object Keys",
      "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name"],
      "settings": {
        "foreground": "#0284c7"
      }
    },
    {
      "name": "HTML & XML Tags",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#0284c7"
      }
    },
    {
      "name": "HTML & CSS Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#d97706"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": ["markup.heading", "punctuation.definition.heading"],
      "settings": {
        "foreground": "#0284c7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#0ea5e9"
      }
    }
  ]
}
