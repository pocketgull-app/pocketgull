{
  "manifest_version": 2,
  "version": "1.2.0",
  "name": "PocketGull Cardstock Kraft Theme",
  "description": "PocketGull PocketGull Cardstock Kraft browser theme engineered for optical legibility and WCAG AAA contrast.",
  "icons": {
    "128": "icon-128.png",
    "512": "icon-512.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pocketgull-cardstock-kraft@theme.pocketgull.app",
      "strict_min_version": "58.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "#ede4c2",
      "frame_inactive": "#f3eccb",
      "tab_selected": "#f9f3d9",
      "tab_background_text": "#78716c",
      "tab_text": "#3b2e1e",
      "tab_line": "#b45309",
      "toolbar": "#f9f3d9",
      "toolbar_text": "#3b2e1e",
      "toolbar_field": "#f9f3d9",
      "toolbar_field_text": "#3b2e1e",
      "toolbar_top_separator": "#e5d6a7",
      "toolbar_bottom_separator": "#e5d6a7",
      "icons": "#b45309",
      "ntp_background": "#f9f3d9",
      "ntp_text": "#3b2e1e"
    }
  }
}
