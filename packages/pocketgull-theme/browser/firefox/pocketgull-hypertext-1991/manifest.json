{
  "manifest_version": 2,
  "version": "1.2.0",
  "name": "PocketGull Hypertext 1991 Theme",
  "description": "Minimalist monochrome precision celebrating the early World Wide Web hypertext workspace.",
  "theme": {
    "colors": {
      "frame": "#e5e5e5",
      "frame_inactive": "#ffffff",
      "tab_selected": "#f5f5f5",
      "tab_background_text": "#555555",
      "tab_text": "#000000",
      "tab_line": "#0000ee",
      "toolbar": "#f5f5f5",
      "toolbar_text": "#000000",
      "toolbar_field": "#ffffff",
      "toolbar_field_text": "#000000",
      "toolbar_top_separator": "#e5e5e5",
      "toolbar_bottom_separator": "#e5e5e5",
      "icons": "#0000ee",
      "ntp_background": "#ffffff",
      "ntp_text": "#000000"
    }
  }
}