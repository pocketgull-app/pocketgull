{
  "manifest_version": 2,
  "version": "1.2.0",
  "name": "PocketGull Hypertext 1991 Theme",
  "description": "PocketGull PocketGull Hypertext 1991 browser theme engineered for optical legibility and WCAG AAA contrast.",
  "icons": {
    "128": "icon-128.png",
    "512": "icon-512.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pocketgull-hypertext-1991@theme.pocketgull.app",
      "strict_min_version": "58.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "#eeeeee",
      "frame_inactive": "#f8f8f8",
      "tab_selected": "#ffffff",
      "tab_background_text": "#666666",
      "tab_text": "#000000",
      "tab_line": "#000080",
      "toolbar": "#ffffff",
      "toolbar_text": "#000000",
      "toolbar_field": "#ffffff",
      "toolbar_field_text": "#000000",
      "toolbar_top_separator": "#cccccc",
      "toolbar_bottom_separator": "#cccccc",
      "icons": "#000080",
      "ntp_background": "#ffffff",
      "ntp_text": "#000000"
    }
  }
}
