{
  "manifest_version": 2,
  "version": "1.2.0",
  "name": "PocketGull Obsidian Theme",
  "description": "PocketGull PocketGull Obsidian browser theme engineered for optical legibility and WCAG AAA contrast.",
  "icons": {
    "128": "icon-128.png",
    "512": "icon-512.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pocketgull-obsidian@theme.pocketgull.app",
      "strict_min_version": "58.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "#09090b",
      "frame_inactive": "#09090b",
      "tab_selected": "#121215",
      "tab_background_text": "#71717a",
      "tab_text": "#f8fafc",
      "tab_line": "#14b8a6",
      "toolbar": "#121215",
      "toolbar_text": "#e4e4e7",
      "toolbar_field": "#09090b",
      "toolbar_field_text": "#e4e4e7",
      "toolbar_top_separator": "#27272a",
      "toolbar_bottom_separator": "#27272a",
      "icons": "#14b8a6",
      "ntp_background": "#09090b",
      "ntp_text": "#e4e4e7"
    }
  }
}
