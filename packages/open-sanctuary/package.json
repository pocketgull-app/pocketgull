{
  "name": "@pocketgull/open-sanctuary",
  "version": "1.0.0",
  "description": "Zero-dependency browser-native Web Audio API bio-entrainment synthesizer, Solfeggio resonance, 432Hz Persian Dastgah modal soundscapes, 0.1Hz parasympathetic breathing pacing, and Chladni cymatics visualizer.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./audio": {
      "types": "./dist/audio-engine.d.ts",
      "import": "./dist/audio-engine.mjs",
      "require": "./dist/audio-engine.js"
    },
    "./cymatics": {
      "types": "./dist/cymatics-renderer.d.ts",
      "import": "./dist/cymatics-renderer.mjs",
      "require": "./dist/cymatics-renderer.js"
    },
    "./catalogs": {
      "types": "./dist/catalogs.d.ts",
      "import": "./dist/catalogs.mjs",
      "require": "./dist/catalogs.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "keywords": [
    "binaural-beats",
    "solfeggio",
    "cymatics",
    "chladni-plate",
    "sound-therapy",
    "parasympathetic-pacing",
    "isochronic-tones",
    "web-audio-api",
    "nervous-system-regulation",
    "persian-dastgah",
    "432hz"
  ],
  "author": "Pocket-Gull Authors & Phillip Gear",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
