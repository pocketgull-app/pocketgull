{
  "manifest_version": 3,
  "name": "Pocket-Gull Clinical Intelligence & EHR Assistant",
  "version": "1.25.0",
  "description": "Real-Time Medical Care Plan Strategy, Bi-Directional Voice Translation & Live AI Consult Engine for Chrome.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Pocket-Gull Clinical Sidepanel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://pocketgull.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://healthcare.googleapis.com/*"
  ]
}
