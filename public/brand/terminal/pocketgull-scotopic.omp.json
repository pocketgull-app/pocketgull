{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "#fee2e2",
          "background": "#7f1d1d",
          "template": " ⚕ POCKETGULL 650nm "
        },
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "#fca5a5",
          "background": "#1a0505",
          "options": {
            "style": "full",
            "folder_icon": "📁 "
          },
          "template": " {{ .Path }} "
        },
        {
          "type": "git",
          "style": "diamond",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "#ffffff",
          "background": "#991b1b",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#dc2626{{ end }}",
            "#991b1b"
          ],
          "template": "  {{ .HEAD }}{{ if or (.Working.Changed) (.Staging.Changed) }} ◈{{ end }}{{ if gt .Ahead 0 }} ▲{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} ▼{{ .Behind }}{{ end }} "
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "#f87171",
          "background": "#2b0b0b",
          "options": {
            "threshold": 50
          },
          "template": " ⏱ {{ .FormattedMs }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "#ef4444",
          "background": "#1a0505",
          "template": " ⠠⠏⠕⠉⠅⠑⠞⠠⠛⠥⠇⠇ ⠠⠍⠕⠝⠕ "
        }
      ]
    }
  ]
}
