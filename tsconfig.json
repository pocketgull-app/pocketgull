{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "strict": false,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "noEmit": false,
    "outDir": "./dist/out-tsc",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@google-cloud/storage": [
        "./src/mocks/empty.ts"
      ],
      "@pocketgull/core-sdk": [
        "./packages/core-sdk/src/index.ts"
      ],
      "@pocketgull/ismp-clinical-guard": [
        "./packages/ismp-clinical-guard/src/index.ts"
      ],
      "@pocketgull/clinical-parquet-duckdb": [
        "./packages/clinical-parquet-duckdb/src/index.ts"
      ],
      "@pocketgull/open-sanctuary": [
        "./packages/open-sanctuary/src/index.ts"
      ],
      "@pocketgull/open-sanctuary/*": [
        "./packages/open-sanctuary/src/*"
      ],
      "@pocketgull/open-scribe": [
        "./packages/open-scribe/src/index.ts"
      ]
    }
  },
  "files": [
    "./main.ts",
    "./src/globals.d.ts",
    "./src/main.server.ts",
    "./src/server.ts",
    "./src/server/dicom.ts",
    "./src/server/healthcare.ts",
    "./src/server/fitbit.ts",
    "./src/server/world-health.ts",
    "./src/server/telemetry.ts",
    "./src/server/genkit.ts"
  ],
  "include": [
    "./src/**/*.ts",
    "./main.ts"
  ],
  "angularCompilerOptions": {
    "disableTypeScriptVersionCheck": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/lib/dataconnect/**"
  ]
}