{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PocketGull Desktop",
  "version": "1.16.0",
  "identifier": "app.pocketgull.desktop",
  "build": {
    "frontendDist": "../dist/browser",
    "devUrl": "http://localhost:4000"
  },
  "app": {
    "windows": [
      {
        "title": "Pocket-Gull Clinical Intelligence Suite",
        "width": 1280,
        "height": 850,
        "resizable": true,
        "fullscreen": false,
        "transparent": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": true
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://generativelanguage.googleapis.com https://healthcare.googleapis.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["all"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "exceptionDomain": ""
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
