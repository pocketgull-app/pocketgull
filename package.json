  "scripts": {
    "postinstall": "npx --no-install patch-package || true",
    "dev": "node --max-old-space-size=8192 node_modules/@angular/cli/bin/ng.js serve",
    "models:retrain": "node scripts/retrain-models.mjs",
    "sentinel:audit": "node scripts/sentinel_security_guard.mjs",
    "clamav:scan": "node scripts/daily-clamav-scan.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "mcp:warmup": "node scripts/mcp-warmup.js",
    "build": "node scripts/build-all.mjs",
    "deploy": "gcloud run deploy pocket-gull --source . --project gen-lang-client-0540208645 --region us-central1 --min-instances=0 --max-instances=5 --update-env-vars=OTEL_SDK_DISABLED=true --update-secrets=\"STRIPE_SECRET_KEY=STRIPE_SECRET_KEY:latest,STRIPE_WEBHOOK_SECRET=STRIPE_WEBHOOK_SECRET:latest\" --timeout=25m --quiet",
    "gcp:prune-storage": "node ./scripts/apply-gcp-lifecycle-policies.mjs",
    "contracts:generate": "node ./scripts/generate-api-contracts.mjs",
    "lint": "node node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit",
    "preview": "node scripts/build-if-missing.cjs && node dist/server/server.mjs",
    "test:e2e": "node ./run-playwright.cjs test",
    "changelog": "echo \"Remember to update CHANGELOG.md before running npm run release\"",
    "serve:ssr:app": "node dist/server/server.mjs",
    "start": "node dist/server/server.mjs",
    "gcp-build": "npm run build && npm prune --production",
    "audit": "lighthouse http://localhost:4000 --view",
    "estimate-effort": "node scripts/estimate-effort.js",
    "estimate-effort:detailed": "node scripts/estimate-effort-detailed.js",
    "precommit": "node scripts/pre-commit-check.cjs",
    "prepare": "node -e \"try { require('husky')() } catch (e) {}\" || true",
    "test": "vitest run --config vitest.config.ts && node scripts/run-python-tests.mjs",
    "test:watch": "vitest",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:e2e:ui": "playwright test --ui",
    "dns:update": "node scripts/update-porkbun-dns.js",
    "kube:start": "minikube start",
    "kube:dev": "skaffold dev",
    "kube:stop": "minikube stop"
  },
